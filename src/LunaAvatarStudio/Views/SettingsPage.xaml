<Page x:Class="LunaAvatarStudio.Views.SettingsPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer>
  <StackPanel Padding="36" Spacing="22" MaxWidth="820">
   <StackPanel Spacing="6">
    <TextBlock Text="SETTINGS" FontSize="12" CharacterSpacing="160" Foreground="#C2C2C2"/>
    <TextBlock Text="Application settings" FontSize="34" FontWeight="SemiBold" Foreground="#FFFFFF"/>
    <TextBlock Text="Local storage and environment information." Foreground="#C2C2C2"/>
   </StackPanel>
   <Border Background="#1D1D1D" CornerRadius="14" Padding="22">
    <StackPanel Spacing="12">
     <TextBlock Text="LOCAL DATA" Foreground="#C2C2C2" FontSize="12" CharacterSpacing="120"/>
     <TextBlock Text="Profiles are stored on this device." Foreground="#FFFFFF"/>
     <TextBlock x:Name="DataPathText" Foreground="#C2C2C2" TextWrapping="Wrap"/>
     <Button Content="Open data folder" Click="OpenDataFolder_Click" HorizontalAlignment="Left"/>
    </StackPanel>
   </Border>
   <Border Background="#111111" BorderBrush="#333333" BorderThickness="1" CornerRadius="14" Padding="22">
    <StackPanel Spacing="8">
     <TextBlock Text="RUNTIME POLICY" Foreground="#C2C2C2" FontSize="12" CharacterSpacing="120"/>
     <TextBlock Text="No microphone or camera permissions are requested by this foundation build. Device capture will be added only alongside a verified runtime and explicit user controls." Foreground="#FFFFFF" TextWrapping="Wrap"/>
    </StackPanel>
   </Border>
  </StackPanel>
 </ScrollViewer>
</Page>
