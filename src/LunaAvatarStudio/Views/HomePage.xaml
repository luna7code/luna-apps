<Page x:Class="LunaAvatarStudio.Views.HomePage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer>
  <StackPanel Padding="36" Spacing="24">
   <StackPanel Spacing="8">
    <TextBlock Text="BECOME YOUR AVATAR" FontSize="12" CharacterSpacing="180" Foreground="#C2C2C2"/>
    <TextBlock Text="Your presence. Reimagined." FontSize="38" FontWeight="SemiBold" Foreground="#FFFFFF"/>
    <TextBlock Text="Create your digital character and build your real-time studio workflow." FontSize="16" Foreground="#C2C2C2" TextWrapping="Wrap"/>
   </StackPanel>
   <Grid ColumnSpacing="16">
    <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="#1D1D1D" CornerRadius="16" Padding="24">
     <StackPanel Spacing="12">
      <TextBlock Text="CHARACTER" FontSize="12" CharacterSpacing="120" Foreground="#C2C2C2"/>
      <TextBlock Text="Build your identity" FontSize="25" FontWeight="SemiBold" Foreground="#FFFFFF"/>
      <TextBlock Text="Create a profile, choose a 2D or 3D direction, and save your character settings locally." Foreground="#C2C2C2" TextWrapping="Wrap"/>
     </StackPanel>
    </Border>
    <Border Grid.Column="1" Background="#1D1D1D" CornerRadius="16" Padding="24">
     <StackPanel Spacing="12">
      <TextBlock Text="RUNTIME STATUS" FontSize="12" CharacterSpacing="100" Foreground="#C2C2C2"/>
      <TextBlock Text="Foundation build" FontSize="20" FontWeight="SemiBold" Foreground="#FFFFFF"/>
      <TextBlock Text="Motion and voice runtimes are not connected in this build." Foreground="#C2C2C2" TextWrapping="Wrap"/>
     </StackPanel>
    </Border>
   </Grid>
   <TextBlock Text="MVP WORKSPACE" FontSize="12" CharacterSpacing="150" Foreground="#C2C2C2"/>
   <Grid ColumnSpacing="16">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="#111111" BorderBrush="#333333" BorderThickness="1" CornerRadius="12" Padding="18">
     <StackPanel Spacing="8"><TextBlock Text="01 / Character" Foreground="#FFFFFF" FontWeight="SemiBold"/><TextBlock Text="Profile and avatar asset settings" Foreground="#C2C2C2" TextWrapping="Wrap"/></StackPanel>
    </Border>
    <Border Grid.Column="1" Background="#111111" BorderBrush="#333333" BorderThickness="1" CornerRadius="12" Padding="18">
     <StackPanel Spacing="8"><TextBlock Text="02 / Studio" Foreground="#FFFFFF" FontWeight="SemiBold"/><TextBlock Text="Runtime availability and diagnostics" Foreground="#C2C2C2" TextWrapping="Wrap"/></StackPanel>
    </Border>
    <Border Grid.Column="2" Background="#111111" BorderBrush="#333333" BorderThickness="1" CornerRadius="12" Padding="18">
     <StackPanel Spacing="8"><TextBlock Text="03 / Settings" Foreground="#FFFFFF" FontWeight="SemiBold"/><TextBlock Text="Local data and application environment" Foreground="#C2C2C2" TextWrapping="Wrap"/></StackPanel>
    </Border>
   </Grid>
   <TextBlock Text="This build is an operational desktop foundation. Camera tracking, voice conversion and broadcast output remain unavailable until verified runtimes are integrated." Foreground="#8F8F8F" FontSize="12" TextWrapping="Wrap"/>
  </StackPanel>
 </ScrollViewer>
</Page>
