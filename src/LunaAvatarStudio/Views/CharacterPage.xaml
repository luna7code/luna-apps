<Page x:Class="LunaAvatarStudio.Views.CharacterPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Loaded="Page_Loaded">
 <ScrollViewer>
  <StackPanel Padding="36" Spacing="22" MaxWidth="760">
   <StackPanel Spacing="6">
    <TextBlock Text="CHARACTER" FontSize="12" CharacterSpacing="160" Foreground="#C2C2C2"/>
    <TextBlock Text="Character profile" FontSize="34" FontWeight="SemiBold" Foreground="#FFFFFF"/>
    <TextBlock Text="Set up your avatar identity. Changes are stored on this Windows device." Foreground="#C2C2C2" TextWrapping="Wrap"/>
   </StackPanel>
   <Border Background="#1D1D1D" CornerRadius="16" Padding="24">
    <StackPanel Spacing="16">
     <TextBlock Text="PROFILE" FontSize="12" CharacterSpacing="120" Foreground="#C2C2C2"/>
     <StackPanel Spacing="6"><TextBlock Text="Character name" Foreground="#FFFFFF"/><TextBox x:Name="CharacterNameBox" PlaceholderText="My Avatar"/></StackPanel>
     <StackPanel Spacing="6">
      <TextBlock Text="Avatar format" Foreground="#FFFFFF"/>
      <ComboBox x:Name="AvatarTypeBox" SelectedIndex="0" HorizontalAlignment="Stretch">
       <ComboBoxItem Content="2D"/><ComboBoxItem Content="3D"/>
      </ComboBox>
     </StackPanel>
     <StackPanel Spacing="6"><TextBlock Text="Avatar asset path (optional)" Foreground="#FFFFFF"/><TextBox x:Name="AvatarAssetPathBox" PlaceholderText="Path to your avatar asset"/></StackPanel>
     <Button Content="Save character profile" Click="SaveProfile_Click" HorizontalAlignment="Left"/>
     <TextBlock x:Name="StatusText" Text="Profile not loaded yet." Foreground="#C2C2C2" TextWrapping="Wrap"/>
    </StackPanel>
   </Border>
   <Border Background="#111111" BorderBrush="#333333" BorderThickness="1" CornerRadius="12" Padding="18">
    <TextBlock Text="Asset import and live avatar rendering are not part of this first foundation build. The selected path is saved as profile metadata only." Foreground="#C2C2C2" TextWrapping="Wrap"/>
   </Border>
  </StackPanel>
 </ScrollViewer>
</Page>
