<Window x:Class="LunaAvatarStudio.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="LUNA AVATAR STUDIO">
 <Grid Background="#080808">
  <NavigationView x:Name="StudioNavigation" PaneDisplayMode="Left" IsBackButtonVisible="Collapsed"
   IsSettingsVisible="False" SelectionChanged="StudioNavigation_SelectionChanged"
   Background="#080808" PaneBackground="#080808" AlwaysShowHeader="True" Header="LUNA AVATAR STUDIO">
   <NavigationView.MenuItems>
    <NavigationViewItem Content="Home" Tag="home"><NavigationViewItem.Icon><SymbolIcon Symbol="Home"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem Content="Character" Tag="character"><NavigationViewItem.Icon><SymbolIcon Symbol="Contact"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem Content="Studio" Tag="studio"><NavigationViewItem.Icon><SymbolIcon Symbol="Video"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem Content="Settings" Tag="settings"><NavigationViewItem.Icon><SymbolIcon Symbol="Setting"/></NavigationViewItem.Icon></NavigationViewItem>
   </NavigationView.MenuItems>
   <Frame x:Name="ContentFrame"/>
  </NavigationView>
 </Grid>
</Window>
